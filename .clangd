CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
# Standalone headers have no callers.
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header
    - -Wno-unused-function

---
If:
  PathMatch:
    - common/scanner\.h
    - test/scanner\.test\.c
CompileFlags:
  Add:
    - -DGSED_EXTENDED=0
